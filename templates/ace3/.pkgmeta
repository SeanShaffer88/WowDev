package-as: {{ADDON_NAME}}

# Externals are fetched by the BigWigs packager at release time
# (docs/09-packaging-and-distribution.md). Ace3's README names the
# WoWAce SVN as the primary source — reference it here, not GitHub.
# LibStub and CallbackHandler-1.0 ship inside the Ace3 tree.
# Keep this list in sync with embeds.xml.
externals:
  Libs/LibStub:
    url: https://repos.wowace.com/wow/ace3/trunk/LibStub
  Libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/ace3/trunk/CallbackHandler-1.0
  Libs/AceAddon-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceAddon-3.0
  Libs/AceEvent-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceEvent-3.0
  Libs/AceDB-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceDB-3.0
  Libs/AceConsole-3.0:
    url: https://repos.wowace.com/wow/ace3/trunk/AceConsole-3.0

enable-nolib-creation: no
